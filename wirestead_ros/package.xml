<?xml version="1.0"?>
<package format="3">
  <name>wirestead_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 integration utilities for the Wirestead communication library.</description>

  <maintainer email="jwsung91@gmail.com">Jinwoo Sung</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://wirestead.github.io/</url>
  <url type="repository">https://github.com/wirestead/wirestead-ros</url>
  <url type="bugtracker">https://github.com/wirestead/wirestead-ros/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>wirestead</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
